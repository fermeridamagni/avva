{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "root": false,
  "overrides": [
    {
      // Disable linting for Shadcn UI components since they are auto-generated and may not follow all linting rules.
      "includes": ["src/components/ui/**/*.{ts,tsx}"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/**/*.css"],
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      }
    }
  ]
}
