CAMERA_INDEX = 0

# Capture resolution — 640×480 is the default, optimized for Pi 5.
# Set to 1280 / 720 for higher quality on more powerful machines.
FRAME_WIDTH=640
FRAME_HEIGHT=480

# Show the OpenCV preview window. Set to "false" in production (e.g. Pi)
# to run headless for better performance.
SHOW_PREVIEW=true

# Home Assistant Server
WS_SERVER_URL=ws://localhost:3000/events
